# Copy to .env.local and fill in. Every service below has a free tier.
# The app runs with NONE of these set (OpenStreetMap data + built-in message template + Demo mode).

# --- Lead data (recommended) ------------------------------------------------
# Google Places API (New). Uses Google's monthly free usage. See README > Google Places.
GOOGLE_PLACES_API_KEY=

# Optional: alternative Overpass mirror for the keyless OpenStreetMap fallback
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# --- AI message writer (pick one; Groq is tried first) --------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Gmail sending (OAuth 2.0) -----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, 32+ chars. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Optional: force the public URL if auto-detection behind a proxy is wrong
# APP_URL=https://your-app.vercel.app
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
